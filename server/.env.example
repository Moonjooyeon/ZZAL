# 서버
PORT=8080
# 프론트를 같은 서버에서 같이 띄울지 (개발용). 배포에서는 0으로 두고 정적 호스팅을 씁니다.
SERVE_WEB=1
# 쿠키 서명 키 — 배포 전에 반드시 바꾸세요 (openssl rand -hex 32)
SESSION_SECRET=change-me-in-production
# 쿠키에 Secure 플래그 (https 배포면 1)
COOKIE_SECURE=0

# 저장소: json | postgres
DB_DRIVER=json
DB_FILE=./data/zzal.json
DATABASE_URL=postgres://user:pass@localhost:5432/zzal

# 소셜 로그인. 키가 없으면 DEMO_AUTH로 임시 로그인만 됩니다.
DEMO_AUTH=1
PUBLIC_ORIGIN=http://localhost:8080

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI (곁들임) ────────────────────────────────────────────────────────
# 키가 없으면 검색과 분류는 규칙만으로 돌아갑니다. 서버는 그대로 뜹니다.
# 쓰려면: cd server && npm install
CAFE24_LLM_ROUTER_API_KEY=
# cafe24/auto 또는 Router에 등록된 모델 ID (예: claude-sonnet-4-6)
AI_MODEL=cafe24/auto
CAFE24_LLM_ROUTER_BASE_URL=https://llm-router.cafe24.com/api/v1
# 호환용 별칭 (선택)
AI_API_KEY=
AI_BASE_URL=

# 올린 짤에 분류와 숨은 키워드를 붙이는 주기 작업
AI_ENRICH=1
AI_ENRICH_INTERVAL_MS=30000
AI_ENRICH_BATCH=3
