# 서버
PORT=8080
# 프론트를 같은 서버에서 같이 띄울지 (개발용). 배포에서는 0으로 두고 정적 호스팅을 씁니다.
SERVE_WEB=1
# 쿠키 서명 키 — 배포 전에 반드시 바꾸세요 (openssl rand -hex 32)
SESSION_SECRET=change-me-in-production
# 쿠키에 Secure 플래그 (https 배포면 1)
COOKIE_SECURE=0

# 저장소: json | postgres
DB_DRIVER=json
DB_FILE=./data/zzal.json
DATABASE_URL=postgres://user:pass@localhost:5432/zzal

# 소셜 로그인. 키가 없으면 DEMO_AUTH로 임시 로그인만 됩니다.
DEMO_AUTH=1
PUBLIC_ORIGIN=http://localhost:8080

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
